---
import { url } from '../lib/rutas.js';
import { ClientRouter } from 'astro:transitions';
import '@fontsource/londrina-solid/400.css';
import '@fontsource/londrina-solid/900.css';
import '@fontsource/yellowtail/400.css';
import '@fontsource/anton/400.css';
import '@fontsource/archivo/400.css';
import '@fontsource/archivo/500.css';
import '@fontsource/archivo/700.css';
import '../styles/papel.css';
import '../styles/global.css';

const { titulo, descripcion = 'La casa de la lucha libre independiente de Guadalajara.', papel = false } = Astro.props;
const ruta = Astro.url.pathname;
const enlaces = [
  ['/cartelera/', 'La Cartelera'],
  ['/luchadores/', 'Los Nuestros'],
  ['/galeria/', 'Galería'],
  ['/mano-a-mano/', 'Mano a Mano'],
  ['/puesto/', 'El Puesto'],
  ['/la-ruta/', 'La Ruta'],
  ['/apoya/', 'Apoya'],
];
---
<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#08080a" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <meta name="description" content={descripcion} />
    <title>{titulo ? `${titulo} · La Tapatía` : 'La Tapatía · Guadalajara contra el mundo'}</title>
    <ClientRouter />
  </head>
  <body class={papel ? 'papel' : ''}>
    <header class="barra" transition:persist>
      <a class="marca" href={url('/')}>La Tapatía</a>
      <input id="menu" class="menu-check" type="checkbox" aria-label="Abrir menú" />
      <label for="menu" class="menu-boton" aria-hidden="true"><span></span><span></span></label>
      <nav aria-label="Principal">
        {enlaces.map(([href, texto]) => <a href={url(href)} aria-current={ruta.startsWith(url(href)) ? 'page' : undefined}>{texto}</a>)}
        <a class="nav-apartado" href={url('/puesto/apartado/')}>Apartado <span data-apartado-total>0</span></a>
      </nav>
    </header>

    <main><slot /></main>

    <footer class="pie-sitio"><div class="ancho">
      <div>
        <p class="pie-marca">La Tapatía</p>
        <p>Guadalajara contra el mundo. Un esfuerzo comunitario de luchadores, promotoras, artistas y aficionados.</p>
      </div>
      <div class="pie-datos">
        <p>Fotografía: <a href={url('/el-lente/')}>Benigno Mata / El Lente Enmascarado</a></p>
        <p>Prototipo. Nombres, biografías y productos están por confirmar con cada persona.</p>
        <p><a href={url('/apoya/')}>Apoya la cobertura</a> · <a href={url('/boletos/')}>Cómo funcionarán los boletos</a></p>
        <p><a href={url('/creditos/')}>Créditos de imágenes</a></p>
      </div>
    </div></footer>

    <dialog class="visor" aria-label="Fotografía ampliada">
      <button class="visor-cerrar" type="button">Cerrar</button>
      <img alt="" />
      <p></p>
    </dialog>

    <script>
      import { iniciar } from '../lib/cliente.js';
      document.addEventListener('astro:page-load', iniciar);
    </script>
  </body>
</html>
