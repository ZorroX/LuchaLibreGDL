---
import Base from '../../layouts/Base.astro';
import Cartel from '../../components/Cartel.astro';
import Rotulo from '../../components/Rotulo.astro';
import Muro from '../../components/Muro.astro';
import TarjetaLuchador from '../../components/TarjetaLuchador.astro';
import { funciones, foto, luchador } from '../../lib/acervo.js';

export function getStaticPaths() {
  return funciones.filter((f) => f.fotos.length).map((f) => ({ params: { slug: f.slug }, props: { f } }));
}
const { f } = Astro.props;
const participantes = [...new Set(f.fotos.flatMap((id) => foto(id).luchadores))].map(luchador).filter(Boolean);
---
<Base titulo={f.nombre} descripcion={`${f.nombre}, ${f.promotora}. Fotografías de Benigno Mata.`}>
  <Cartel rotulo={f.nombre} titulo={f.nombre} ocultarTitulo acto={f.promotora} lema={`${f.fechaTexto} · ${f.arena}`} fotos={f.fotos} plantillas={['portada', 'tira', 'muro', 'portada', 'tira']} />

  {participantes.length > 0 && (
    <section class="bloque lona"><div class="ancho">
      <Rotulo as="h2" ajuste="titulo" texto="En el ring" />
      <div class="tira pegados">{participantes.map((l) => <TarjetaLuchador l={l} />)}</div>
    </div></section>
  )}

  <section class="bloque"><div class="ancho">
    <Rotulo as="h2" ajuste="titulo" texto="La función en fotos" />
    <Muro ids={f.fotos} />
  </div></section>
</Base>
