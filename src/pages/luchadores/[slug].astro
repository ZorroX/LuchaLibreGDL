---
import { url } from '../../lib/rutas.js';
import Base from '../../layouts/Base.astro';
import Cartel from '../../components/Cartel.astro';
import Rotulo from '../../components/Rotulo.astro';
import Muro from '../../components/Muro.astro';
import { luchadores, funciones, foto, instagram } from '../../lib/acervo.js';

export function getStaticPaths() {
  return luchadores.map((l) => ({ params: { slug: l.slug }, props: { l } }));
}
const { l } = Astro.props;
const sus = funciones.filter((f) => l.fotos.some((id) => foto(id).funcion === f.slug));
---
<Base titulo={l.nombre} descripcion={`${l.nombre}: fotografías y perfil en La Tapatía.`}>
  <Cartel rotulo={l.nombre} titulo={l.nombre} ocultarTitulo acto={l.apodo || 'Los Nuestros'} lema={`${l.fotos.length} ${l.fotos.length === 1 ? 'fotografía' : 'fotografías'} de El Lente Enmascarado`} fotos={l.fotos} plantillas={['portada', 'tira', 'muro', 'portada']}>
    <a class="boton" href={instagram(l.handle)} target="_blank" rel="noreferrer">Seguir en Instagram</a>
  </Cartel>

  <section class="bloque lona"><div class="ancho perfil-datos">
    <div>
      <Rotulo as="h2" ajuste="titulo" texto="Biografía" />
      <p>Estamos preparando esta biografía con {l.nombre}. Aquí vivirán su historia, su estilo y sus mejores luchas.</p>
    </div>
    <dl class="tabla" style="margin:0">
      <div><dt>Instagram</dt><dd>@{l.handle}</dd></div>
      <div><dt>Fotografías</dt><dd>{l.fotos.length}</dd></div>
      <div><dt>Funciones</dt><dd>{sus.length ? sus.map((f, i) => <>{i > 0 && ', '}<a href={url(`/cartelera/${f.slug}/`)}>{f.nombre}</a></>) : 'Por confirmar'}</dd></div>
      <div><dt>Su merch</dt><dd>{l.marcaExterna ? 'No disponible' : 'Cuando exista acuerdo con su participación'}</dd></div>
    </dl>
  </div></section>

  <section class="bloque"><div class="ancho">
    <Rotulo as="h2" ajuste="titulo" texto="En el ring" />
    <Muro ids={l.fotos} />
  </div></section>
</Base>
