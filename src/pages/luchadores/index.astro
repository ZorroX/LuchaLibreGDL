---
import Base from '../../layouts/Base.astro';
import Cartel from '../../components/Cartel.astro';
import TarjetaLuchador from '../../components/TarjetaLuchador.astro';
import { luchadores, locales } from '../../lib/acervo.js';
---
<Base titulo="Los Nuestros" descripcion="Luchadores de la escena independiente de Guadalajara.">
  <Cartel rotulo="Los Nuestros" titulo="Quienes suben al ring" lema={`${luchadores.length} luchadores retratados por El Lente Enmascarado.`} fotos={locales.slice(0, 6).map((l) => l.fotos[0])} />

  <section class="bloque"><div class="ancho">
    <p style="margin-bottom:24px">Sus perfiles irán creciendo con la información que cada uno comparta.</p>
    <label class="nota" for="buscar-luchador" style="display:block;margin-bottom:6px">Buscar por nombre</label>
    <input class="campo" id="buscar-luchador" type="search" autocomplete="off" placeholder="Por ejemplo: Yokai" />
    <p data-sin-resultados hidden style="margin-top:24px">No encontramos ese nombre. Revisa cómo se escribe o prueba con su apodo.</p>
    <div class="rejilla pegados" style="margin-top:28px">
      {luchadores.map((l) => <TarjetaLuchador l={l} />)}
    </div>
  </div></section>
</Base>
