---
import { url } from '../lib/rutas.js';
import Base from '../layouts/Base.astro';
import Cartel from '../components/Cartel.astro';
import Rotulo from '../components/Rotulo.astro';
import TarjetaLuchador from '../components/TarjetaLuchador.astro';
import { locales } from '../lib/acervo.js';

const temas = [
  ['El origen', 'Quién te enseñó, en qué arena empezaste y qué te hizo quedarte.'],
  ['La máscara', 'Lo que representa tu personaje y lo que eliges mantener en secreto.'],
  ['La rivalidad', 'La lucha que más te marcó y la que todavía te falta.'],
  ['Guadalajara', 'Qué hace distinta a la lucha de aquí y qué necesita para crecer.'],
];
---
<Base titulo="Mano a Mano" papel descripcion="Entrevistas con luchadores de Guadalajara.">
  <Cartel rotulo="Mano a Mano" titulo="Las historias detrás del ring" lema="Entrevistas con la gente que hace la lucha en Guadalajara." fotos={locales.slice(0, 4).map((l) => l.fotos[0])} />

  <section class="bloque"><div class="ancho">
    <p>Las primeras entrevistas están en preparación. Cada conversación respetará lo que el luchador quiera proteger de su identidad.</p>
    <div class="casas pegados" style="margin-top:36px;grid-template-columns:repeat(auto-fit,minmax(240px,1fr))">
      {temas.map(([t, d]) => <div><h3>{t}</h3><p>{d}</p></div>)}
    </div>
  </div></section>
  <section class="bloque" style="padding-top:0"><div class="ancho">
    <Rotulo as="h2" ajuste="titulo" texto="Primeras candidaturas" />
    <p class="nota" style="margin-bottom:22px">Propuesta inicial, según su presencia en el acervo.</p>
    <div class="rejilla pegados">{locales.slice(0, 4).map((l) => <TarjetaLuchador l={l} />)}</div>
    <div class="aviso" style="margin-top:44px">
      <h3>Que sigan las entrevistas</h3>
      <p style="margin-bottom:16px">Cada conversación cuesta traslado, audio y edición. Si quieres que haya más, apóyalas.</p>
      <a class="boton" href={url('/apoya/')}>Apoya las entrevistas</a>
    </div>
  </div></section>
</Base>
