---
import { url } from '../lib/rutas.js';
import Base from '../layouts/Base.astro';
import Cartel from '../components/Cartel.astro';
import Rotulo from '../components/Rotulo.astro';
import Desglose from '../components/Desglose.astro';
import { pasadas, foto, luchador } from '../lib/acervo.js';
import { desgloseBoleto, pesos } from '../lib/reparto.js';

// Maqueta con una función ya luchada: así se vería la compra cuando una promotora suba la siguiente.
const f = pasadas.find((x) => x.fotos.length >= 10 && x.promotora !== 'Por confirmar' && x.arena !== 'Por confirmar') ?? pasadas[0];
const cartel = [...new Set(f.fotos.flatMap((id) => foto(id).luchadores))].map(luchador).filter(Boolean);
const precio = 200;
const datos = { precio, promotora: f.promotora, cartel: cartel.length };
const propinas = [0, 50, 100, 200];
---
<Base titulo="Boletos" descripcion="Así se comprarán los boletos de las funciones independientes de Guadalajara.">
  <Cartel rotulo="Boletos" titulo="Tu entrada, y algo para el cartel" lema="Compra en línea y, si quieres, deja propina a un luchador, a todo el cartel o a la arena." fotos={f.fotos} plantillas={['portada', 'tira', 'muro']} />

  <section class="bloque"><div class="ancho dos dinero">
    <div>
      <p class="acto">Maqueta · Ejemplo con {f.nombre}</p>
      <Rotulo as="h2" ajuste="titulo" texto="Así se comprarán" />
      <p>Cuando una promotora suba su próxima función, aquí se comprarán los boletos. La entrada es de la promotora y la propina llega completa a quien elijas, menos la comisión del cobro.</p>
      <dl class="tabla">
        <div><dt>Función</dt><dd>{f.nombre}</dd></div>
        <div><dt>Promotora</dt><dd>{f.promotora}</dd></div>
        <div><dt>Arena</dt><dd>{f.arena}</dd></div>
        <div><dt>Entrada</dt><dd>{pesos(precio)} de ejemplo</dd></div>
        <div><dt>En la puerta</dt><dd>Muestras el código QR de tu boleto desde el celular.</dd></div>
      </dl>
      <p class="nota" style="margin-top:18px">Si La Tapatía llega a cobrar una comisión por boleto, se mostrará aquí. Está por acordarse con las promotoras.</p>
    </div>
    <form class="tablero" data-boletos={JSON.stringify(datos)}>
      <fieldset>
        <legend>Entradas</legend>
        <div class="cantidad">
          <button type="button" data-cantidad="-1" aria-label="Una entrada menos">−</button>
          <input type="number" name="cantidad" min="1" max="10" value="1" aria-label="Número de entradas" />
          <button type="button" data-cantidad="1" aria-label="Una entrada más">+</button>
        </div>
      </fieldset>
      <fieldset>
        <legend>Propina</legend>
        <div class="fichas">
          {propinas.map((n) => <label><input type="radio" name="propina" value={n} checked={n === 50} /><span>{n ? pesos(n) : 'Sin propina'}</span></label>)}
          <label><input type="radio" name="propina" value="otra" /><span>Otra</span></label>
        </div>
        <input class="campo" type="number" name="propina-otra" min="0" step="10" placeholder="¿Cuánto?" aria-label="Otra propina, en pesos" hidden />
      </fieldset>
      <fieldset>
        <legend>¿Para quién?</legend>
        <label class="opcion"><input type="radio" name="para" value="cartel" checked /> Todo el cartel, parejo</label>
        <label class="opcion"><input type="radio" name="para" value="luchador" /> Un luchador:</label>
        <select class="campo" name="luchador" aria-label="Luchador que recibe la propina" disabled>
          {cartel.map((l) => <option>{l.nombre}</option>)}
        </select>
        <label class="opcion"><input type="radio" name="para" value="arena" /> La arena</label>
      </fieldset>
      <Desglose desglose={desgloseBoleto({ ...datos, cantidad: 1, propina: 50, para: `el cartel (${cartel.length} luchadores, parejo)` })} />
      <button class="boton" type="button" disabled>Compra no disponible en el prototipo</button>
    </form>
  </div></section>

  <section class="bloque lona"><div class="ancho">
    <Rotulo as="h2" ajuste="titulo" texto="En el cartel" />
    <p style="margin-bottom:24px">Quienes lucharon en {f.nombre}. <a href={url(`/cartelera/${f.slug}/`)}>Ver la función en fotos</a></p>
    <div class="nombres">{cartel.map((l) => <a href={url(`/luchadores/${l.slug}/`)}>{l.nombre}</a>)}</div>
  </div></section>
</Base>
