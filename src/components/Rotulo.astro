---
// El texto queda visible hasta que el navegador pinta el rótulo a pincel encima.
// ajuste="titulo": título de sección, del tamaño de su letra en CSS y alineado a la izquierda.
const { texto, lineas = [texto], estilo, ajuste, as: Tag = 'div', class: clase = '' } = Astro.props;
---
<Tag class:list={['rotulo', { titulo: ajuste === 'titulo' }, clase]} data-rotulo={JSON.stringify(lineas)} data-estilo={estilo ?? (ajuste ? undefined : 'barrio')} data-ajuste={ajuste}>
  <span class="rotulo-texto">{lineas.join(' ')}</span>
  <canvas aria-hidden="true"></canvas>
</Tag>
